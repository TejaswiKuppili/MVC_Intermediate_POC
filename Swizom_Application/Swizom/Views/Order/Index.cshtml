@model IEnumerable<Swizom.ViewDataModels.OrderDTO>

@{
    ViewData["Title"] = "Orders";
}
<script src="~/js/Order/Order.js" asp-append-version="true"></script>

<h2 class="mb-4">Orders</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> Place New Order
</a>

<!--Searches only in current page | Client-Side Pagination-->

@* <div class="d-flex justify-content-between align-items-center mb-3">
    <input type="text" id="searchInput" class="form-control w-25" placeholder="Search orders..." onkeyup="filterOrders()">
</div> *@

<!--Searches in all the pages | Server-Side Pagination implemented for better performance-->
<form asp-controller="Order" asp-action="Index" method="get" class="mb-3 d-flex">
    <div class="input-group d-flex justify-content-between align-items-center mb-3">
        <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search orders..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="row">
    @foreach (var order in Model)
    {
        <div class="col-md-6 mb-4 order-card">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-person-circle"></i> @order.CustomerName
                    </h5>

                    <p>
                        <i class="bi bi-telephone"></i> <strong>@order.CustomerPhone</strong>
                    </p>

                    <p>
                        <i class="bi bi-envelope"></i> <strong>@order.CustomerEmail</strong>
                    </p>

                    <p class="text-muted">
                        <i class="bi bi-geo-alt"></i> @order.DeliveryAddress
                    </p>

                    <p class="fw-bold">
                        <i class="bi bi-cash"></i> @order.TotalAmount.ToString("C")
                    </p>

                    <p>
                        <span class="badge bg-@GetStatusBadgeClass(order.Status.ToString())">
                            <i class="bi bi-info-circle"></i> @order.Status
                        </span>
                    </p>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@order.OrderID" class="btn btn-warning btn-sm" data-bs-toggle="tooltip" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <a asp-action="Delete" asp-route-id="@order.OrderID" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- No Results Message -->
@if (!Model.Any())
{
    <p class="text-center text-muted mt-3">
        No orders found.
    </p>
}

<!-- Pagination -->
<div id="paginationContainer">
    <nav>
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>
            }

            @if (ViewBag.TotalPages <= 6)
            {
                // Show all pages if total pages are 6 or less
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchQuery" asp-route-page="@i">@i</a>
                    </li>
                }
            }
            else
            {
                // Show first page
                <li class="page-item @(1 == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
                </li>

                // Show "..." if needed
                @if (ViewBag.CurrentPage > 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Show 2 pages before and after current page
                @for (int i = Math.Max(2, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages - 1, ViewBag.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                // Show "..." if needed
                @if (ViewBag.CurrentPage < ViewBag.TotalPages - 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Show last page
                <li class="page-item @(ViewBag.TotalPages == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@ViewBag.TotalPages">@ViewBag.TotalPages</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "warning",
            "Processing" => "primary",
            "Completed" => "success",
            "Canceled" => "danger",
            _ => "secondary"
        };
    }
}
