@model IEnumerable<Swizom.ViewDataModels.MenuItemDTO>

@{
    ViewData["Title"] = "Menu Items";
}
<script src="~/js/MenuItem/MenuItem.js" asp-append-version="true"></script>

<h2 class="mb-4">Menu Items</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> Add New Item
</a>

<div class="d-flex justify-content-between align-items-center mb-3">
    <input type="text" id="searchInput" class="form-control w-25" placeholder="Search items..." onkeyup="filterMenuItems()">
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4 menu-item-card">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box-seam"></i> @item.Name
                    </h5>

                    <h6 class="text-muted">
                        <i class="bi bi-tag"></i> @item.CategoryName
                    </h6>

                    <p class="card-text">
                        <span class="badge bg-success">@item.Price.ToString("C")</span>
                    </p>

                    <p class="text-muted">
                        <i class="bi bi-shop"></i> <strong>@item.RestaurantName</strong>
                    </p>

                    <p class="description text-truncate" title="@item.Description">
                        <i class="bi bi-info-circle"></i>
                        @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                    </p>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@item.ItemID" class="btn btn-warning btn-sm" data-bs-toggle="tooltip" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.ItemID" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- No Results Message -->
<p id="noResultsMessage" class="text-center text-muted mt-3" style="display: none;">No menu items found.</p>

<!-- Pagination -->
<nav>
    <ul class="pagination justify-content-center">
        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-restaurantId="@ViewBag.RestaurantId" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
            </li>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-restaurantId="@ViewBag.RestaurantId" asp-route-page="@i">@i</a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-restaurantId="@ViewBag.RestaurantId" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
            </li>
        }
    </ul>
</nav>