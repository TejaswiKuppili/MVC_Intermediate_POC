@model IEnumerable<Swizom.ViewDataModels.MenuItemDTO>

@{
    ViewData["Title"] = "Menu Items";
}
<script src="~/js/MenuItem/MenuItem.js" asp-append-version="true"></script>

<h2 class="mb-4">Menu Items</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> Add New Item
</a>

<!--Searches only in current page | Client-Side Pagination-->

@* <div class="d-flex justify-content-between align-items-center mb-3">
    <input type="text" id="searchInput" class="form-control w-25" placeholder="Search items..." onkeyup="filterMenuItems()">
</div> *@

<!--Searches in all the pages | Server-Side Pagination implemented for better performance-->
<form asp-controller="MenuItem" asp-action="Index" method="get" class="mb-3 d-flex">
    <div class="input-group d-flex justify-content-between align-items-center mb-3">
        <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search menu items..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4 menu-item-card">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box-seam"></i> @item.Name
                    </h5>

                    <h6 class="text-muted">
                        <i class="bi bi-tag"></i> @item.CategoryName
                    </h6>

                    <p class="card-text">
                        <span class="badge bg-success">@item.Price.ToString("C")</span>
                    </p>

                    <p class="text-muted">
                        <i class="bi bi-shop"></i> <strong>@item.RestaurantName</strong>
                    </p>

                    <p class="description text-truncate" title="@item.Description">
                        <i class="bi bi-info-circle"></i>
                        @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                    </p>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@item.ItemID" class="btn btn-warning btn-sm" data-bs-toggle="tooltip" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.ItemID" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- No Results Message -->
@if (!Model.Any())
{
    <p class="text-center text-muted mt-3">
        No menu items found.
    </p>
}

<!-- Pagination -->
<div id="paginationContainer">
    <nav>
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>
            }

            @if (ViewBag.TotalPages <= 6)
            {
                // Show all pages if total pages are 6 or less
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchQuery" asp-route-page="@i">@i</a>
                    </li>
                }
            }
            else
            {
                // Show first page
                <li class="page-item @(1 == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
                </li>

                // Show "..." if needed
                @if (ViewBag.CurrentPage > 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Show 2 pages before and after current page
                @for (int i = Math.Max(2, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages - 1, ViewBag.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                // Show "..." if needed
                @if (ViewBag.CurrentPage < ViewBag.TotalPages - 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Show last page
                <li class="page-item @(ViewBag.TotalPages == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@ViewBag.TotalPages">@ViewBag.TotalPages</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>